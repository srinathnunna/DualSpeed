<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F9"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ DualSpeed"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#1A237E"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Parallel Wi-Fi + SIM Channel Aggregator"
            android:textSize="13sp"
            android:textColor="#616161"
            android:layout_marginBottom="18dp" />

        <!-- Networks Status Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:elevation="3dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvWifiStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📶 Wi-Fi: Connecting..."
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#F57C00"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvCellularStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📶 Mobile Data (SIM): Connecting..."
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#F57C00"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/tvNetworkHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Please ensure both Wi-Fi and Mobile Data toggles are ON."
                android:textSize="12sp"
                android:textColor="#757575" />
        </LinearLayout>

        <!-- Download URL -->
        <EditText
            android:id="@+id/etUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Direct download link (HTTP/HTTPS)"
            android:textSize="14sp"
            android:padding="12dp"
            android:background="#FFFFFF"
            android:elevation="2dp"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="14dp">

            <Button
                android:id="@+id/btnSampleUrl"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Sample (25 MB)"
                android:textSize="12sp"
                android:backgroundTint="#546E7A"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnSampleLarge"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Sample (50 MB)"
                android:textSize="12sp"
                android:backgroundTint="#455A64"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <Button
            android:id="@+id/btnDownload"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="START DUAL DOWNLOAD"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="#1565C0"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="18dp" />

        <!-- Live Progress and Speed Dashboard -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:elevation="3dp"
            android:layout_marginBottom="16dp">

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:max="100"
                android:progress="0"
                android:visibility="gone"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textSize="14sp"
                android:textColor="#212121"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvSpeedWifi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wi-Fi Speed: 0.0 MB/s"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#1976D2"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvSpeedCellular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mobile SIM Speed: 0.0 MB/s"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#E65100"
                android:layout_marginBottom="8dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvSpeedTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Combined Speed: 0.0 MB/s"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#2E7D32" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ready."
            android:textSize="13sp"
            android:textColor="#424242" />

    </LinearLayout>
</ScrollView>
